<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="createLoanDialog"
        title="New Loan Application"
        contentWidth="30rem"
        afterClose=".onCreateDialogAfterClose">

        <content>
            <VBox class="sapUiMediumMargin">

                <Label text="Amount" required="true" />
                <Input
                    value="{amount}"
                    valueLiveUpdate="true"
                    placeholder="Enter amount" />

                <Label text="Currency" required="true" class="sapUiSmallMarginTop" />
                <Input
                    value="{currency}"
                    valueLiveUpdate="true" />

                <Label text="Purpose" required="true" class="sapUiSmallMarginTop" />
                <Input
                    value="{purpose}"
                    valueLiveUpdate="true"
                    placeholder="Enter loan purpose" />

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Create"
                type="Emphasized"
                press=".onCreateLoanConfirm" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCreateLoanCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>