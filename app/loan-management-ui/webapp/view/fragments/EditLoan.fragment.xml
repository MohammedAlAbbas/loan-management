<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="editLoanDialog"
        title="Edit Loan Application"
        contentWidth="30rem">

        <content>
            <VBox class="sapUiMediumMargin">

                <Label text="Amount" required="true" />
                <Input
                    id="amountInput"
                    value="{amount}"
                    valueLiveUpdate="true"
                    placeholder="Enter amount" />

                <Label text="Currency" required="true" class="sapUiSmallMarginTop" />
                <Input
                    id="currencyInput"
                    value="{currency}"
                    valueLiveUpdate="true" />

                <Label text="Purpose" required="true" class="sapUiSmallMarginTop" />
                <Input
                    id="purposeInput"
                    value="{purpose}"
                    valueLiveUpdate="true"
                    placeholder="Enter loan purpose" />

            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onEditLoanConfirm" />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onEditLoanCancel" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>