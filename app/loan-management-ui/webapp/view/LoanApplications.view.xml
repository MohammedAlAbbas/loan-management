<mvc:View
    controllerName="loan.management.ui.loanmanagementui.controller.LoanApplications"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="page"
        title="{i18n>title}">

        <content>

            <Table
                id="loanTable"
                items="{
                    path: '/LoanApplications',
                    parameters: {
                        $expand: 'status'
                    }
                }">

                <headerToolbar>
                    <Toolbar>

                        <Title
                            text="Loan Applications"/>

                        <ToolbarSpacer/>

                        <Button
                            text="New Loan"
                            type="Emphasized"
                            press=".onCreateLoan"/>

                    </Toolbar>
                </headerToolbar>

                <columns>

                    <Column>
                        <Text text="Amount"/>
                    </Column>

                    <Column>
                        <Text text="Currency"/>
                    </Column>

                    <Column>
                        <Text text="Purpose"/>
                    </Column>

                    <Column>
                        <Text text="Status"/>
                    </Column>
                    <Column width="7rem" hAlign="End">
                        <Text text="Actions" />
                    </Column>

                </columns>

                <items>

                    <ColumnListItem>

                        <cells>

                            <Text
                                text="{amount}"/>

                            <Text
                                text="{currency}"/>

                            <Text
                                text="{purpose}"/>

                            <ObjectStatus
                                text="{status/text}"
                                state="Information"
                                tooltip="{status_code}"/>

                            <HBox justifyContent="End">
                                <Button
                                    icon="sap-icon://edit"
                                    type="Transparent"
                                    tooltip="Edit Loan"
                                    press=".onPressEditLoan" />
                                <Button
                                    icon="sap-icon://delete"
                                    type="Transparent"
                                    state="Negative"
                                    tooltip="Delete Loan"
                                    press=".onPressDeleteLoan" />
                            </HBox>

                        </cells>

                    </ColumnListItem>

                </items>

            </Table>

        </content>

    </Page>

</mvc:View>
