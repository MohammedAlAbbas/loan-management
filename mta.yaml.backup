_schema-version: 3.3.0

ID: loan-management
version: 1.0.0

description: "A simple CAP project."

parameters:
  enable-parallel-deployments: true
  deploy_mode: html5-repo

build-parameters:
  before-all:
    - builder: custom
      commands:
        - npm ci
        - npx cds build --production

modules:

  # =========================================================
  # CAP SERVICE
  # =========================================================
  - name: loan-management-srv
    type: nodejs
    path: gen/srv

    parameters:
      instances: 1
      buildpack: nodejs_buildpack

    build-parameters:
      builder: npm-ci

    provides:
      - name: srv-api
        properties:
          srv-url: ${default-url}

    requires:
      - name: loan-management-db
      - name: loan-management-auth


  # =========================================================
  # HANA DB DEPLOYER
  # =========================================================
  - name: loan-management-db-deployer
    type: hdb
    path: gen/db

    parameters:
      buildpack: nodejs_buildpack

    requires:
      - name: loan-management-db


  # =========================================================
  # UI5 APPLICATION
  # =========================================================
  - name: loan-management-ui
    type: html5
    path: app/loan-management-ui

    build-parameters:
      builder: custom

      commands:
        - npm ci
        - npx ui5 build --all
        - sh -c 'cd dist && zip -r ../loan-management-ui.zip . -x loan-management-ui.zip'

      build-result: .

      supported-platforms: []


  # =========================================================
  # HTML5 APPLICATION REPOSITORY CONTENT
  # =========================================================
  - name: loan-management-ui-deployer
    type: com.sap.application.content
    path: .

    requires:
      - name: loan-management-html5-repo-host
        parameters:
          content-target: true

    build-parameters:
      build-result: resources

      requires:
        - name: loan-management-ui
          artifacts:
            - loan-management-ui.zip
          target-path: resources/


  # =========================================================
  # APPLICATION ROUTER
  # =========================================================
  - name: loan-management-router
    type: approuter.nodejs
    path: app/router

    parameters:
      memory: 256M
      disk-quota: 256M

    requires:
      - name: loan-management-auth

      - name: loan-management-html5-repo-runtime

      - name: srv-api
        group: destinations
        properties:
          name: srv-api
          url: ~{srv-url}
          forwardAuthToken: true


# =========================================================
# RESOURCES
# =========================================================

resources:

  # =========================================================
  # HANA
  # =========================================================
  - name: loan-management-db
    type: com.sap.xs.hdi-container

    parameters:
      service: hana
      service-plan: hdi-shared


  # =========================================================
  # XSUAA
  # =========================================================
  - name: loan-management-auth
    type: org.cloudfoundry.managed-service

    parameters:
      service: xsuaa
      service-plan: application

      path: ./xs-security.json

      config:
        xsappname: loan-management-${org}-${space}
        tenant-mode: dedicated

        oauth2-configuration:
          credential-types:
            - "binding-secret"
            - "x509"


  # =========================================================
  # HTML5 APPLICATION REPOSITORY - HOST
  # =========================================================
  - name: loan-management-html5-repo-host
    type: org.cloudfoundry.managed-service

    parameters:
      service: html5-apps-repo
      service-plan: app-host


  # =========================================================
  # HTML5 APPLICATION REPOSITORY - RUNTIME
  # =========================================================
  - name: loan-management-html5-repo-runtime
    type: org.cloudfoundry.managed-service

    parameters:
      service: html5-apps-repo
      service-plan: app-runtime