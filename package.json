{
  "devDependencies": {
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds": "^10.1.0",
    "@sap/xssec": "^4"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "users": {
          "requester": {
            "password": "requester",
            "roles": [
              "LoanRequester"
            ]
          },
          "approver": {
            "password": "approver",
            "roles": [
              "LoanApprover"
            ]
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      },
      "html5-repo": true
    }
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "start": "cds-serve",
    "watch-loan-management-ui": "cds watch --open loan.management.ui.loanmanagementui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/loan-management-ui"
  ]
}
