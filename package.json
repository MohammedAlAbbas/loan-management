{
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "cds-plugin-ui5": "^0.17.0"
  },
  "dependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^10.1.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "users": {
          "requester": {
            "password": "requester",
            "roles": [
              "LoanRequester"
            ]
          },
          "approver": {
            "password": "approver",
            "roles": [
              "LoanApprover"
            ]
          }
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "scripts": {
    "watch-loan-management-ui": "cds watch --open loan.management.ui.loanmanagementui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-loan-management-fe": "cds watch --open loan.management.fe.loanmanagementfe/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "sapux": [
    "app/loan-management-fe"
  ]
}
