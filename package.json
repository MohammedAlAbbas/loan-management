{
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds": "^10.1.0"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": "db.sqlite"
        }
      },
      "auth": {
        "users": {
          "requester": {
            "password": "requester",
            "roles": [
              "LoanRequester"
            ]
          },
          "approver": {
            "password": "approver",
            "roles": [
              "LoanApprover"
            ]
          }
        }
      }
    }
  }
}